# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# TODO(client): set every value below for the new client/project.

# ── Browser-exposed (Next.js public) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server-only / Edge Function secrets ────────────────────────────────────
# Set these in Supabase Dashboard → Edge Functions → Secrets (never in the frontend).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxx
ADMIN_NOTIFY_EMAIL=admin@example.com

# ── Optional SMS (set TWILIO_ENABLED=true to activate) ─────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
